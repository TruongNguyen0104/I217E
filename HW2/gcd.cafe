
mod! GCD {
    -- imports
    pr(NAT) 
    -- signature
    op gcd : Nat Zero -> Nat .
    op gcd : Nat NzNat -> NzNat .
    op gcd : Nat Nat -> Nat . -- CafeOBJvars
    var X : Nat .
    var NzY : NzNat . -- equations
    eq gcd(X,0) = X .
    eq gcd(X,NzY) = gcd(NzY,X rem NzY) .
}

open GCD . 
red gcd(57,3) . 
red gcd(24,36) . 
red gcd(2015,31031) .
close 