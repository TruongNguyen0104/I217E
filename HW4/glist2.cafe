mod* TRIV-ERR {  
[Elt Err < Elt&Err]
op err : -> Err .
}

mod! GLIST2(E :: TRIV-ERR) {
[Nil NnList < List]
op nil : -> Nil {constr} .
op _|_ : Elt.E List -> NnList {constr} .
op hd : Nil -> Err.E .
op hd : NnList -> Elt.E .
op hd : List -> Elt&Err.E .
op tl : List -> List .
op _@_ : List List -> List .
var X  : Elt.E .
vars L L2 : List .
eq hd(nil) = err.E .
eq hd(X | L) = X .
eq tl(nil) = nil .
eq tl(X | L) = L .
eq nil @ L2 = L2 .
eq (X | L) @ L2 = X | (L @ L2) .
}

open GLIST2 .
  red hd(nil) .
  red tl(nil) .
  
  red nil @ nil .
  red nil @ (nil @ nil) .
  red (nil @ nil) @ nil .

  red hd(tl(nil)) .
  red tl(tl(nil)) .
  red hd(nil @ nil) .
  red tl(nil @ nil) .
  red tl(nil) @ nil .
  red nil @ tl(nil) .

  red hd(tl(nil @ nil)) .
  red tl(tl(nil) @ tl(nil)) .

close