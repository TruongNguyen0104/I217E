-- ================================================================
-- I217 Functional Programming
-- Lecture Note 12 - Program Verification: Lists
-- Exercises 1 and 2
--
-- One-module version: LIST1 contains all list specifications from
-- the slides, including concatenation, rev1, rev2, and sr2.
--
-- Important:
--   * _@_ is NOT declared with the {assoc} attribute. We prove
--     associativity explicitly as Theorem 1.
--   * In the proof score for p-sr2, assoc@ is added as a temporary
--     equation because that theorem has already been proved above.
--
-- Run with CafeOBJ. The red commands are intended to reduce to true.
-- ================================================================

-- ---------------------------------------------------------------
-- 1. LIST1: lists, concatenation, and two reverse implementations
-- ---------------------------------------------------------------
mod! LIST1 (E :: TRIV) {
  [ List ]

  -- List constructors
  op nil : -> List {constr} .
  op _|_ : Elt.E List -> List {constr} .

  -- Concatenation
  op _@_ : List List -> List .

  -- Recursive reverse
  op rev1 : List -> List .

  -- Tail-recursive reverse and its helper
  op rev2 : List -> List .
  op sr2 : List List -> List .

  vars E E2 : Elt.E .
  vars L1 L2 L3 : List .

  -- Equality for lists
  eq (nil = E | L1) = false .
  eq (E | L1 = E2 | L2) = (E = E2) and (L1 = L2) .

  -- Concatenation equations (@1), (@2)
  eq nil @ L2 = L2 .
  eq (E | L1) @ L2 = E | (L1 @ L2) .

  -- Recursive reverse equations (r1-1), (r1-2)
  eq rev1(nil) = nil .
  eq rev1(E | L1) = rev1(L1) @ (E | nil) .

  -- Tail-recursive reverse equations (r2), (sr2-1), (sr2-2)
  eq rev2(L1) = sr2(L1,nil) .
  eq sr2(nil,L2) = L2 .
  eq sr2(E | L1,L2) = sr2(L1,E | L2) .
}

-- ===============================================================
-- EXERCISE 1: Proof scores corresponding to Lecture Note 12
-- ===============================================================

-- ---------------------------------------------------------------
-- Theorem 1: Associativity of concatenation (assoc@)
-- (L1 @ L2) @ L3 = L1 @ (L2 @ L3)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- Base case: L1 = nil
open LIST1 .
  ops l2 l3 : -> List .
  red (nil @ l2) @ l3 = nil @ (l2 @ l3) .
close

-- Induction case: L1 = e | l1
-- IH: (l1 @ L2) @ L3 = l1 @ (L2 @ L3)
open LIST1 .
  ops l1 l2 l3 : -> List .
  op e : -> Elt.E .
  eq (l1 @ L2) @ L3 = l1 @ (L2 @ L3) .
  red ((e | l1) @ l2) @ l3 = (e | l1) @ (l2 @ l3) .
close

-- ---------------------------------------------------------------
-- Lemma 1: A property of sr2 (p-sr2)
-- sr2(L1,E2 | L2) = sr2(L1,nil) @ (E2 | L2)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- Base case: L1 = nil
open LIST1 .
  op l2 : -> List .
  op e2 : -> Elt.E .
  red sr2(nil,e2 | l2) = sr2(nil,nil) @ (e2 | l2) .
close

-- Induction case: L1 = e | l1
-- IH: sr2(l1,E2 | L2) = sr2(l1,nil) @ (E2 | L2)
-- The already-proved associativity theorem is made available here.
open LIST1 .
  ops l1 l2 : -> List .
  ops e e2 : -> Elt.E .
  eq (L1 @ L2) @ L3 = L1 @ (L2 @ L3) .
  eq sr2(l1,E2 | L2) = sr2(l1,nil) @ (E2 | L2) .
  red sr2(e | l1,e2 | l2) = sr2(e | l1,nil) @ (e2 | l2) .
close

-- ---------------------------------------------------------------
-- Theorem 2: Correctness of tail-recursive reverse (ctrr)
-- rev1(L1) = rev2(L1)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- Base case: L1 = nil
open LIST1 .
  red rev1(nil) = rev2(nil) .
close

-- Induction case: L1 = e | l1
-- IH: rev1(l1) = rev2(l1)
-- Use Lemma p-sr2.
open LIST1 .
  op l1 : -> List .
  op e : -> Elt.E .
  eq rev1(l1) = rev2(l1) .
  eq sr2(L1,E2 | L2) = sr2(L1,nil) @ (E2 | L2) .
  red rev1(e | l1) = rev2(e | l1) .
close

-- ===============================================================
-- EXERCISE 2: Prove rev1(rev1(L)) = L for every list L
-- ===============================================================

-- ---------------------------------------------------------------
-- Auxiliary Lemma 2: Reversing a concatenation with a singleton
-- rev1(L @ (E | nil)) = E | rev1(L)
-- Structural induction on L
-- ---------------------------------------------------------------

-- Base case: L = nil
open LIST1 .
  op e : -> Elt.E .
  red rev1(nil @ (e | nil)) = e | rev1(nil) .
close

-- Induction case: L = e1 | l1
-- IH: rev1(l1 @ (E | nil)) = E | rev1(l1)
open LIST1 .
  op l1 : -> List .
  ops e1 e2 : -> Elt.E .
  eq rev1(l1 @ (E | nil)) = E | rev1(l1) .
  red rev1((e1 | l1) @ (e2 | nil)) = e2 | rev1(e1 | l1) .
close

-- ---------------------------------------------------------------
-- Theorem 3: Reverse is an involution
-- rev1(rev1(L)) = L
-- Structural induction on L
-- ---------------------------------------------------------------

-- Base case: L = nil
open LIST1 .
  red rev1(rev1(nil)) = nil .
close

-- Induction case: L = e | l1
-- IH: rev1(rev1(l1)) = l1
-- Use Auxiliary Lemma 2.
open LIST1 .
  op l1 : -> List .
  op e : -> Elt.E .
  eq rev1(rev1(l1)) = l1 .
  eq rev1(L1 @ (E | nil)) = E | rev1(L1) .
  red rev1(rev1(e | l1)) = e | l1 .
close

-- ---------------------------------------------------------------
-- Optional reductions to observe the two reverse implementations
-- ---------------------------------------------------------------
open LIST1 .
  ops e1 e2 e3 : -> Elt.E .
  red rev1(e1 | e2 | e3 | nil) = e3 | e2 | e1 | nil .
  red rev2(e1 | e2 | e3 | nil) = e3 | e2 | e1 | nil .
  red rev1(rev1(e1 | e2 | e3 | nil)) = e1 | e2 | e3 | nil .
close

-- =========================== END ===============================
