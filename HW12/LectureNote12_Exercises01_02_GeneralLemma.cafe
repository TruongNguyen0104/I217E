-- ================================================================
-- I217 Functional Programming
-- Lecture Note 12 - Program Verification: Lists
-- Exercises 1 and 2
--
-- Organized following the lecture slides:
--   LIST1 : lists, concatenation, rev1, and Theorem 1 (assoc@)
--   LIST2 : corresponding list specification with associative @,
--           plus rev2/sr2, Lemma 1 (p-sr2), and Theorem 2 (ctrr)
--
-- Exercise 2 is added after the slide proofs:
--   Lemma 2 : rev1(L @ (E | nil)) = E | rev1(L)
--   Theorem 3 : rev1(rev1(L)) = L
-- ================================================================

-- ---------------------------------------------------------------
-- 1. LIST1: list specification, concatenation, and rev1
-- ---------------------------------------------------------------
mod! LIST1 (E :: TRIV) {
  [ List ]

  op nil : -> List {constr} .
  op _|_ : Elt.E List -> List {constr} .

  op _@_ : List List -> List .
  op rev1 : List -> List .

  vars E E2 : Elt.E .
  vars L1 L2 L3 : List .

  -- Equality on lists
  eq (nil = E | L1) = false .
  eq (E | L1 = E2 | L2) = (E = E2) and (L1 = L2) .

  -- Concatenation
  eq nil @ L2 = L2 .
  eq (E | L1) @ L2 = E | (L1 @ L2) .

  -- Reverse (recursive version)
  eq rev1(nil) = nil .
  eq rev1(E | L1) = rev1(L1) @ (E | nil) .
}

-- ---------------------------------------------------------------
-- Exercise 1 / Theorem 1: Associativity of concatenation (assoc@)
-- (L1 @ L2) @ L3 = L1 @ (L2 @ L3)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- I. Base case: L1 = nil
open LIST1 .
  -- fresh constants
  ops l2 l3 : -> List .
  -- check
  red (nil @ l2) @ l3 = nil @ (l2 @ l3) .
close

-- II. Induction case: L1 = e | l1
-- IH: (l1 @ L2) @ L3 = l1 @ (L2 @ L3)
open LIST1 .
  -- fresh constants
  ops l1 l2 l3 : -> List .
  op e : -> Elt.E .
  -- induction hypothesis
  eq (l1 @ L2) @ L3 = l1 @ (L2 @ L3) .
  -- check
  red ((e | l1) @ l2) @ l3 = (e | l1) @ (l2 @ l3) .
close

-- ---------------------------------------------------------------
-- 2. LIST2: list specification used for tail-recursive reverse
-- As in the later slides, @ is declared associative here so that
-- assoc@ is available when proving p-sr2.
-- ---------------------------------------------------------------
mod! LIST2 (E :: TRIV) {
  [ List ]

  op nil : -> List {constr} .
  op _|_ : Elt.E List -> List {constr} .

  op _@_ : List List -> List {assoc} .
  op rev1 : List -> List .
  op rev2 : List -> List .
  op sr2 : List List -> List .

  vars E E2 : Elt.E .
  vars L1 L2 L3 : List .

  -- Equality on lists
  eq (nil = E | L1) = false .
  eq (E | L1 = E2 | L2) = (E = E2) and (L1 = L2) .

  -- Concatenation
  eq nil @ L2 = L2 .
  eq (E | L1) @ L2 = E | (L1 @ L2) .

  -- Recursive reverse
  eq rev1(nil) = nil .
  eq rev1(E | L1) = rev1(L1) @ (E | nil) .

  -- Tail-recursive reverse
  eq rev2(L1) = sr2(L1,nil) .
  eq sr2(nil,L2) = L2 .
  eq sr2(E | L1,L2) = sr2(L1,E | L2) .
}

-- ---------------------------------------------------------------
-- Exercise 1 / Lemma 1: A property of sr2 (p-sr2)
-- sr2(L1,E2 | L2) = sr2(L1,nil) @ (E2 | L2)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- I. Base case: L1 = nil
open LIST2 .
  -- fresh constants
  op l2 : -> List .
  op e2 : -> Elt.E .
  -- check
  red sr2(nil,e2 | l2) = sr2(nil,nil) @ (e2 | l2) .
close

-- II. Induction case: L1 = e | l1
-- IH: sr2(l1,E2 | L2) = sr2(l1,nil) @ (E2 | L2)
open LIST2 .
  -- fresh constants
  ops l1 l2 : -> List .
  ops e e2 : -> Elt.E .
  -- induction hypothesis
  eq sr2(l1,E2 | L2) = sr2(l1,nil) @ (E2 | L2) .
  -- check
  red sr2(e | l1,e2 | l2) = sr2(e | l1,nil) @ (e2 | l2) .
close

-- ---------------------------------------------------------------
-- Exercise 1 / Theorem 2: Correctness of tail-recursive reverse
-- (ctrr): rev1(L1) = rev2(L1)
-- Structural induction on L1
-- ---------------------------------------------------------------

-- I. Base case: L1 = nil
open LIST2 .
  -- check
  red rev1(nil) = rev2(nil) .
close

-- II. Induction case: L1 = e | l1
-- IH: rev1(l1) = rev2(l1)
-- Lemma: p-sr2
open LIST2 .
  -- fresh constants
  op l1 : -> List .
  op e : -> Elt.E .
  -- induction hypothesis
  eq rev1(l1) = rev2(l1) .
  -- lemma p-sr2
  eq sr2(L1,E2 | L2) = sr2(L1,nil) @ (E2 | L2) .
  -- check
  red rev1(e | l1) = rev2(e | l1) .
close

-- ===============================================================
-- EXERCISE 2: Prove rev1(rev1(L)) = L for all lists L
-- ===============================================================

-- ---------------------------------------------------------------
-- Helper Lemma: Right identity of concatenation (@-nil)
-- L @ nil = L
-- Structural induction on L
-- This is needed because @ is defined recursively on its first
-- argument, so CafeOBJ cannot reduce a variable-list @ nil directly.
-- ---------------------------------------------------------------

-- I. Base case: L = nil
open LIST2 .
  red nil @ nil = nil .
close

-- II. Induction case: L = e | l
-- IH: l @ nil = l
open LIST2 .
  -- fresh constants
  op l : -> List .
  op e : -> Elt.E .
  -- induction hypothesis
  eq l @ nil = l .
  -- check
  red (e | l) @ nil = e | l .
close

-- ---------------------------------------------------------------
-- Lemma 2: General reverse-concatenation property
-- rev1(rev1(L1) @ L2) = rev1(L2) @ L1
-- Structural induction on L1
-- Uses the associativity of @ (assoc@) and the helper lemma @-nil.
-- ---------------------------------------------------------------

-- I. Base case: L1 = nil
open LIST2 .
  -- fresh constant
  op l2 : -> List .
  -- helper lemma: L1 @ nil = L1
  eq L1 @ nil = L1 .
  -- check
  red rev1(rev1(nil) @ l2) = rev1(l2) @ nil .
close

-- II. Induction case: L1 = e | l1
-- IH: rev1(rev1(l1) @ L2) = rev1(L2) @ l1
open LIST2 .
  -- fresh constants
  ops l1 l2 : -> List .
  op e : -> Elt.E .
  -- induction hypothesis
  eq rev1(rev1(l1) @ L2) = rev1(L2) @ l1 .
  -- check
  red rev1(rev1(e | l1) @ l2) = rev1(l2) @ (e | l1) .
close

-- ---------------------------------------------------------------
-- Exercise 2 / Theorem 3: Involution of reverse
-- rev1(rev1(L1)) = L1
-- The generalized Lemma 2 is strong enough to prove the induction
-- case directly; a separate induction-hypothesis equation is not
-- needed in this proof score.
-- ---------------------------------------------------------------

-- I. Base case: L1 = nil
open LIST2 .
  -- check
  red rev1(rev1(nil)) = nil .
close

-- II. Induction case: L1 = e | l1
-- Apply Lemma 2 with L1 = l1 and L2 = (e | nil).
open LIST2 .
  -- fresh constants
  op l1 : -> List .
  op e : -> Elt.E .
  -- Lemma 2: rev1(rev1(L1) @ L2) = rev1(L2) @ L1
  eq rev1(rev1(L1) @ L2) = rev1(L2) @ L1 .
  -- check
  red rev1(rev1(e | l1)) = e | l1 .
close

-- =========================== END ===============================
